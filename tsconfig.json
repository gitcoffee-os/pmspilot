{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "customConditions": ["development"],
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "preserve",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "~/*": ["./src/*"],
      "@/*": ["./src/*"],
      "@gitcoffee/api/auth": ["../../packages/core/api/src/api/auth/index.ts"],
      "@gitcoffee/api": ["../../packages/core/api/src/index.ts"],
      "@gitcoffee/pmspilot-utils/auth": ["../../packages/utils/pmspilot-utils/src/auth/index.ts"],
      "@gitcoffee/pmspilot-utils/avatar": ["../../packages/utils/pmspilot-utils/src/avatar/index.ts"],
      "@gitcoffee/pmspilot-utils/date": ["../../packages/utils/pmspilot-utils/src/date/index.ts"],
      "@gitcoffee/pmspilot-utils": ["../../packages/utils/pmspilot-utils/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts", "src/**/*.tsx", "src/**/*.vue", "index.html"],
  "exclude": ["node_modules", "dist"]
}
