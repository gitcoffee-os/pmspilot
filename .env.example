# PmsPilot 环境变量配置示例
# 复制此文件为 .env 并填入实际值

# API 基础地址
# 留空时走 vite 代理（/exmay -> http://localhost:8080）
# 也可直填后端地址，如 http://localhost:8080/exmay/admin/api
VITE_API_BASE_URL=

# 应用标题
VITE_GLOB_APP_TITLE=PmsPilot 飞项

# 数据源：默认开发环境使用 Mock 数据
# 设置为 api 时开发环境也请求真实后端
VITE_DATA_SOURCE=
# 显式开启 Mock（生产预览时可用）
VITE_USE_MOCK=false
