{
  "semi": true,
  "singleQuote": true,
  "tabWidth": 2,
  "trailingComma": "all",
  "printWidth": 100,
  "endOfLine": "lf",
  "plugins": ["@ianvs/prettier-plugin-sort-imports"],
  "importOrder": [
    "^(vue/(.*)$)|^(vue$)",
    "^(vue-router/(.*)$)|^(vue-router$)",
    "^(pinia/(.*)$)|^(pinia$)",
    "^(vue-i18n/(.*)$)|^(vue-i18n$)",
    "^@gitcoffee-os/(.*)$",
    "^@/(.*)$",
    "^~/(.*)$",
    "^[./]"
  ],
  "importOrderParserPlugins": ["typescript", "jsx", "decorators-legacy"],
  "importOrderTypeScriptVersion": "5.0.0"
}
